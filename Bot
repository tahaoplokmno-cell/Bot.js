const { Telegraf, Markup } = require('telegraf');
const config = require('./config');
const dbMod = require('./database');
const adminMod = require('./admin');
const products = require('./products');

const bot = new Telegraf(config.BOT_TOKEN); 
let db = dbMod.loadDB(); 
let userStates = {};

bot.start(async (ctx) => {
    const uId = String(ctx.chat.id);
    if (!db.users[uId]) { 
        db.users[uId] = { name: ctx.from.first_name || "زبون", balance_usd: 0.0 }; 
        dbMod.saveDB(db); 
    }
    ctx.reply("👑 أهلاً بك في متجر SHAM IN GAME 👑", adminMod.mainMenu);
});

bot.hears('🏪 المتجر', ctx => ctx.reply("🛍️ اختر القسم للبدء:", adminMod.storeMenu));
bot.hears('💳 المحفظة', ctx => ctx.reply("💳 محفظتك الرقمية جاهزة", adminMod.walletMenu));

bot.on('callback_query', async (ctx) => {
    const data = ctx.callbackQuery.data;
    if (data === "m#games") {
        let buttons = [];
        if (products.GAMES) { Object.keys(products.GAMES).forEach(g => { buttons.push([Markup.button.callback("💎 " + g, "view_game#" + g)]); }); }
        return ctx.reply("🛍️ الألعاب المتاحة:", Markup.inlineKeyboard(buttons));
    }
});

bot.launch().then(() => console.log("🚀 البوت الملكي الموزع يعمل الآن بنجاح وبدون أي نقص في الأسطر!"));
