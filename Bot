function generateCustomerProfilePage(targetId, db) {
    if (!db || !db.users) return "❌ خطأ في قاعدة البيانات.";
    const u = db.users[targetId];
    if (!u) return `❌ لم يتم العثور على أي زبون مسجل بهذا الآيدي: \`${targetId}\``;
    
    let statusText = "🟢 نشط وآمن (ACTIVE)";
    if (db.banned && db.banned[targetId]) statusText = "🚫 محظور نهائياً (BANNED)";
    else if (db.muted && db.muted[targetId]) statusText = "🔇 مكتوم ومقيد (MUTED)";

    const joinedAt = u.joined_at || "غير مسجل مسبقاً";
    const lastActive = u.last_active || "لا توجد حركات";
    const currentAction = u.current_action || "🗺️ يتصفح القائمة الرئيسية";

    let logsHistory = "📝 لا يوجد سجل تحركات حتى الآن.";
    if (u.history && u.history.length > 0) {
        const recentLogs = u.history.slice(-10);
        logsHistory = recentLogs.map((log, index) => `🔹 [${index + 1}] ${log}`).join("\n");
    }

    return `🛰️ **نظام المراقبة والرادار الشامل (حساب العميل)** 🛰️\n` +
           `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
           `🆔 آيدي التليجرام: \`${targetId}\`\n` +
           `👤 اسم الحساب: *${u.name || "بدون اسم"}*\n` +
           `🏷️ اليوزر نيم: ${u.username ? '@' + u.username : '*لا يوجد*'}\n` +
           `💵 رصيد المحفظة الحالي: *${(u.balance_usd || 0).toFixed(2)}$*\n` +
